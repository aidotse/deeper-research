{
  "permissions": {
    "allow": [
      "mcp__asta__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/asta_config.py\" --quiet || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && mdformat . 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
