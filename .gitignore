# Python
__pycache__/
*.pyc
.venv/

# Local, per-machine settings
.claude/settings.local.json
.claude/worktrees/
.serena/project.local.yml

# Full texts fetched from arXiv by deeper_research/fulltext.py. Third-party text, and
# regenerable with `uv run python -m deeper_research.fulltext <topic> <id>`.
graphs/*/fulltext/

# The viewer is generated from the survey and clusters.json by deeper_research/graph.py,
# and is large; rebuild it rather than track it.
graphs/*/graph.html

# Compact sheets for the naming and fringe agents, written by deeper_research/sheets.py from
# clusters.json; regenerable.
graphs/*/naming-sheet.md
graphs/*/fringe-sheet.md

# Checkpoint copies of files the repo ignores, kept by a simulation audit
# (docs/audits.md, "Starting states"); regenerable.
.audits/*-sim/*/segments/runs/checkpoints/

# Editors and OS
.DS_Store
*.swp
.idea/
.vscode/
